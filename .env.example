# Azure settings for the optional adapters. The offline core needs none of these.
# Authentication uses DefaultAzureCredential (Azure CLI login, managed identity, or
# environment credentials). No API keys are read from this file.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
